FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install GUI and browser
RUN apt-get update && apt-get install -y \
    firefox \
    xvfb \
    x11vnc \
    fluxbox \
    dbus-x11 \
    xdg-utils \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Create user
RUN useradd -m -s /bin/bash browser

# Simple startup script without password complexity
RUN echo '#!/bin/bash\n\
export DISPLAY=:0\n\
echo "Starting Xvfb..."\n\
Xvfb :0 -screen 0 1280x720x24 &\n\
sleep 3\n\
\n\
echo "Starting fluxbox..."\n\
fluxbox &\n\
sleep 2\n\
\n\
echo "Starting VNC (no password for testing)..."\n\
x11vnc -display :0 -noxrecord -noxfixes -noxdamage -forever -nopw &\n\
sleep 2\n\
\n\
echo "Starting Firefox..."\n\
firefox --new-instance --no-remote --display=:0 &\n\
\n\
echo "Browser ready! Connect via VNC to localhost:5900 (no password)"\n\
\n\
tail -f /dev/null\n\
' > /start-browser.sh && chmod +x /start-browser.sh

USER browser
WORKDIR /home/browser

EXPOSE 5900
CMD ["/start-browser.sh"]
