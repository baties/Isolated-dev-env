FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install GUI and browser
RUN apt-get update && apt-get install -y \
    firefox \
    xvfb \
    x11vnc \
    fluxbox \
    dbus-x11 \
    xdg-utils \
    wget \
    xclip \
    && rm -rf /var/lib/apt/lists/*

# Create user
RUN useradd -m -s /bin/bash browser

# Simple two-way clipboard sync script, mirrors the desktop image's script
RUN echo '#!/bin/bash\n\
    echo "Clipboard sync started"\n\
    last_host_clip=""\n\
    last_container_clip=""\n\
    while true; do\n\
    if [ -f "/tmp/clipboard-sync/host-to-container" ]; then\n\
    new_clip=$(cat "/tmp/clipboard-sync/host-to-container" 2>/dev/null)\n\
    if [ -n "$new_clip" ] && [ "$new_clip" != "$last_host_clip" ]; then\n\
    echo "$new_clip" | xclip -selection clipboard\n\
    last_host_clip="$new_clip"\n\
    echo "" > "/tmp/clipboard-sync/host-to-container"\n\
    fi\n\
    fi\n\
    current_clip=$(xclip -o -selection clipboard 2>/dev/null)\n\
    if [ -n "$current_clip" ] && [ "$current_clip" != "$last_container_clip" ]; then\n\
    echo "$current_clip" > "/tmp/clipboard-sync/container-to-host"\n\
    last_container_clip="$current_clip"\n\
    fi\n\
    sleep 0.3\n\
    done' > /usr/local/bin/clipboard-sync.sh && chmod +x /usr/local/bin/clipboard-sync.sh

# Simple startup script with fixed display
RUN echo '#!/bin/bash\n\
    export DISPLAY=:1\n\
    echo "Starting Xvfb on display :1..."\n\
    Xvfb :1 -screen 0 1280x720x24 &\n\
    sleep 3\n\
    \n\
    echo "Starting fluxbox..."\n\
    DISPLAY=:1 fluxbox &\n\
    sleep 2\n\
    \n\
    echo "Starting VNC on port 5900..."\n\
    x11vnc -display :1 -rfbport 5900 -noxrecord -noxfixes -noxdamage -forever -nopw -listen 0.0.0.0 &\n\
    sleep 2\n\
    \n\
    echo "Starting Firefox..."\n\
    DISPLAY=:1 firefox --new-instance --no-remote &\n\
    sleep 1\n\
    \n\
    echo "Starting clipboard sync..."\n\
    /usr/local/bin/clipboard-sync.sh &\n\
    \n\
    echo "Simple Browser ready! Connect via VNC to localhost:5900 (no password)"\n\
    echo "Services running:"\n\
    ps aux | grep -E "(Xvfb|x11vnc|fluxbox)" | grep -v grep\n\
    \n\
    tail -f /dev/null\n\
    ' > /start-browser.sh && chmod +x /start-browser.sh

USER browser
WORKDIR /home/browser

EXPOSE 5900
CMD ["/start-browser.sh"]
