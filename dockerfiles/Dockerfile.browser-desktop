FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install full desktop environment
RUN apt-get update && apt-get install -y \
    firefox \
    xvfb \
    x11vnc \
    xfce4 \
    xfce4-terminal \
    xfce4-panel \
    xfce4-session \
    xfce4-settings \
    xfwm4 \
    dbus-x11 \
    xdg-utils \
    wget \
    thunar \
    mousepad \
    supervisor \
    procps \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Create user
RUN useradd -m -s /bin/bash -G audio,video browser

# Create directories
RUN mkdir -p /home/browser/.vnc /etc/supervisor/conf.d /var/log/supervisor
RUN chown -R browser:browser /home/browser/.vnc

# Supervisor config with different display
RUN echo '[supervisord]\n\
nodaemon=true\n\
user=root\n\
logfile=/var/log/supervisor/supervisord.log\n\
pidfile=/var/run/supervisord.pid\n\
\n\
[program:xvfb]\n\
command=Xvfb :2 -screen 0 1280x720x24 -ac +extension GLX +render -noreset\n\
user=browser\n\
autostart=true\n\
autorestart=true\n\
environment=DISPLAY=:2\n\
stdout_logfile=/var/log/supervisor/xvfb.log\n\
stderr_logfile=/var/log/supervisor/xvfb_error.log\n\
priority=100\n\
\n\
[program:dbus-session]\n\
command=/bin/bash -c "dbus-launch --sh-syntax --exit-with-session > /tmp/dbus-env && source /tmp/dbus-env && sleep infinity"\n\
user=browser\n\
autostart=true\n\
autorestart=true\n\
environment=DISPLAY=:2,HOME=/home/browser,USER=browser\n\
stdout_logfile=/var/log/supervisor/dbus.log\n\
stderr_logfile=/var/log/supervisor/dbus_error.log\n\
priority=200\n\
\n\
[program:xfce4]\n\
command=/bin/bash -c "sleep 5 && source /tmp/dbus-env 2>/dev/null || true && DISPLAY=:2 /usr/bin/startxfce4"\n\
user=browser\n\
autostart=true\n\
autorestart=true\n\
environment=DISPLAY=:2,HOME=/home/browser,USER=browser\n\
stdout_logfile=/var/log/supervisor/xfce4.log\n\
stderr_logfile=/var/log/supervisor/xfce4_error.log\n\
priority=300\n\
\n\
[program:x11vnc]\n\
command=/bin/bash -c "sleep 8 && x11vnc -display :2 -forever -shared -nopw -listen 0.0.0.0 -rfbport 5901 -xkb -noxrecord -noxfixes -noxdamage"\n\
user=browser\n\
autostart=true\n\
autorestart=true\n\
environment=DISPLAY=:2\n\
stdout_logfile=/var/log/supervisor/x11vnc.log\n\
stderr_logfile=/var/log/supervisor/x11vnc_error.log\n\
priority=400\n\
' > /etc/supervisor/conf.d/desktop.conf

# Set permissions
RUN chown -R browser:browser /home/browser

USER root
WORKDIR /home/browser

EXPOSE 5901
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]