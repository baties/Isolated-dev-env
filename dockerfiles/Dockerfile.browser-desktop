FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install full desktop environment
RUN apt-get update && apt-get install -y \
    firefox \
    xvfb \
    x11vnc \
    xfce4 \
    xfce4-terminal \
    dbus-x11 \
    xdg-utils \
    wget \
    thunar \
    mousepad \
    && rm -rf /var/lib/apt/lists/*

# Create user
RUN useradd -m -s /bin/bash browser

# Create desktop startup script
RUN echo '#!/bin/bash\n\
export DISPLAY=:0\n\
echo "Starting Xvfb..."\n\
Xvfb :0 -screen 0 1280x720x24 &\n\
sleep 3\n\
\n\
echo "Starting XFCE desktop..."\n\
startxfce4 &\n\
sleep 5\n\
\n\
echo "Starting VNC..."\n\
x11vnc -display :0 -noxrecord -noxfixes -noxdamage -forever -nopw &\n\
sleep 2\n\
\n\
echo "Desktop ready! You can open Firefox from the desktop menu"\n\
\n\
tail -f /dev/null\n\
' > /start-desktop.sh && chmod +x /start-desktop.sh

USER browser
WORKDIR /home/browser

EXPOSE 5900
CMD ["/start-desktop.sh"]