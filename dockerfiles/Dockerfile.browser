FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install GUI and browser
RUN apt-get update && apt-get install -y \
    firefox \
    xvfb \
    x11vnc \
    fluxbox \
    dbus-x11 \
    xdg-utils \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Create user
RUN useradd -m -s /bin/bash browser

# Create startup script
RUN echo '#!/bin/bash\n\
export DISPLAY=:0\n\
Xvfb :0 -screen 0 1280x720x24 &\n\
sleep 2\n\
fluxbox &\n\
x11vnc -display :0 -noxrecord -noxfixes -noxdamage -forever -passwd /tmp/vncpass &\n\
sleep 2\n\
firefox --new-instance --no-remote --display=:0\n\
' > /start-browser.sh && chmod +x /start-browser.sh

# Set VNC password
RUN mkdir -p /tmp && echo "browser123" | x11vnc -storepasswd /tmp/vncpass

USER browser
WORKDIR /home/browser

CMD ["/start-browser.sh"]


