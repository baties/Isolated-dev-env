FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies first
RUN apt-get update && apt-get install -y \
    curl \
    git \
    vim \
    nano \
    htop \
    net-tools \
    iputils-ping \
    wget \
    unzip \
    build-essential \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install Python 3.9 (correct package names for Ubuntu 20.04)
RUN apt-get update && apt-get install -y \
    python3.9 \
    python3-pip \
    python3.9-dev \
    python3.9-distutils \
    && rm -rf /var/lib/apt/lists/*

# Create symlinks for python
RUN ln -sf /usr/bin/python3.9 /usr/bin/python && \
    ln -sf /usr/bin/python3.9 /usr/bin/python3

# Upgrade pip to latest version
RUN python3.9 -m pip install --upgrade pip

# Handle user creation more carefully
RUN if ! getent group 1000; then groupadd -g 1000 devuser; fi && \
    if ! getent passwd 1000; then useradd -u 1000 -g 1000 -m -s /bin/bash devuser; else usermod -g 1000 -s /bin/bash $(getent passwd 1000 | cut -d: -f1); fi

# Install Python packages
RUN pip install --no-cache-dir \
    flask \
    fastapi \
    uvicorn \
    django \
    requests \
    numpy \
    pandas \
    jupyter \
    pytest

# Install Node.js packages globally
RUN npm install -g \
    typescript \
    ts-node \
    nodemon \
    @angular/cli \
    create-react-app \
    express-generator

# Set up workspace
RUN mkdir -p /workspace/projects /workspace/shared
RUN chown -R 1000:1000 /workspace

USER 1000
WORKDIR /workspace

CMD ["tail", "-f", "/dev/null"]