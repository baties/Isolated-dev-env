FROM node:18-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    vim \
    nano \
    htop \
    net-tools \
    iputils-ping \
    wget \
    unzip \
    python3 \
    python3-pip \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Handle user creation more carefully
RUN if ! getent group 1000; then groupadd -g 1000 devuser; fi && \
    if ! getent passwd 1000; then useradd -u 1000 -g 1000 -m devuser; else usermod -g 1000 $(getent passwd 1000 | cut -d: -f1); fi

# Install global Node.js packages
RUN npm install -g \
    typescript \
    ts-node \
    nodemon \
    @angular/cli \
    create-react-app \
    express-generator \
    pm2

# Set up workspace
RUN mkdir -p /workspace/projects /workspace/shared
RUN chown -R 1000:1000 /workspace

USER 1000
WORKDIR /workspace

# Keep container running
CMD ["tail", "-f", "/dev/null"]