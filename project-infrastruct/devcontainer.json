{
    "name": "Isolated Test Environment",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "multi-env",
    "workspaceFolder": "/workspace/projects/${localWorkspaceFolderBasename}",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.vscode-typescript-next",
                "ms-vscode.vscode-json",
                "ms-vscode.vscode-eslint",
                "ms-python.black-formatter"
            ]
        }
    },
    "postCreateCommand": "echo 'Container ready for testing!'",
    "remoteUser": "devuser"
}